{
  "name": "osmyka-site",
  "version": "2.0.0",
  "description": "Osmyka OU - custom CRM, booking platforms and turnkey web development for auto repair shops and service SMBs",
  "scripts": {
    "dev": "npx serve .",
    "preview": "npx serve .",
    "docs:dev": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "docs:serve": "npm --prefix docs run serve",
    "build:all": "npm --prefix docs run build",
    "deploy": "npx wrangler pages deploy . --project-name osmyka"
  },
  "keywords": [
    "osmyka",
    "crm",
    "booking",
    "auto-repair",
    "web-development",
    "cloudflare-pages",
    "docusaurus"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
